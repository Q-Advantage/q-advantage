{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qadvantage.io/schema/protocol_result.schema.json",
  "title": "Q-Shield protocol benchmark result",
  "description": "One measured record per (protocol, mode, suite). Designed so the Week-7 P-CBOM export is a mapping, not a redesign.",
  "type": "object",
  "required": ["identity", "timing", "size", "toolchain", "host", "audit"],
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "required": ["protocol", "mode", "suite"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "type": "string", "enum": ["tls", "ssh"] },
        "mode": { "type": "string", "enum": ["composed", "live"] },
        "suite": {
          "type": "string",
          "description": "Group / kex string, e.g. X25519MLKEM768 or mlkem768x25519-sha256"
        }
      }
    },
    "timing": { "$ref": "#/$defs/timing_stats" },
    "phases": {
      "type": "object",
      "description": "Layer-A phase decomposition. Keys are phase names; absent for live mode (black-box total).",
      "additionalProperties": { "$ref": "#/$defs/timing_stats" }
    },
    "size": {
      "type": "object",
      "required": ["bytes_client_to_server", "bytes_server_to_client", "bytes_total"],
      "additionalProperties": false,
      "properties": {
        "bytes_client_to_server": { "type": "integer", "minimum": 0 },
        "bytes_server_to_client": { "type": "integer", "minimum": 0 },
        "bytes_total": { "type": "integer", "minimum": 0 }
      }
    },
    "baseline": {
      "type": "object",
      "description": "Comparison to the matched classical suite. Null on a baseline record itself.",
      "additionalProperties": false,
      "properties": {
        "baseline_suite": { "type": ["string", "null"] },
        "pct_over_classical": { "type": ["number", "null"] }
      }
    },
    "cross_validation": {
      "type": "object",
      "description": "Agreement against canonical references (eBACS/SUPERCOP, liboqs speed tools). See reference_notes for the cycles-vs-nanoseconds caveat.",
      "additionalProperties": false,
      "properties": {
        "ebacs_reference_cycles": { "type": ["number", "null"] },
        "liboqs_speed_number": { "type": ["number", "null"] },
        "measured_vs_reference_pct": { "type": ["number", "null"] },
        "reference_notes": { "type": ["string", "null"] }
      }
    },
    "auth": {
      "type": ["object", "null"],
      "description": "Signature/auth track. First-class because it serves both PQ-cert handshakes and the blockchain framing (signature size + verify speed).",
      "additionalProperties": false,
      "properties": {
        "scheme": { "type": "string" },
        "sign": { "$ref": "#/$defs/timing_stats" },
        "verify": { "$ref": "#/$defs/timing_stats" },
        "signature_bytes": { "type": "integer", "minimum": 0 },
        "public_key_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["liboqs", "liboqs_python"],
      "additionalProperties": false,
      "properties": {
        "liboqs": { "type": ["string", "null"] },
        "liboqs_python": { "type": ["string", "null"] },
        "openssl_runtime": { "type": ["string", "null"], "description": "OpenSSL Python was linked against (ssl.OPENSSL_VERSION)" },
        "openssl_cli": { "type": ["string", "null"], "description": "System `openssl version` (relevant to live mode)" },
        "oqs_provider": { "type": ["string", "null"] },
        "openssh": { "type": ["string", "null"] }
      }
    },
    "host": {
      "type": "object",
      "required": ["arch"],
      "additionalProperties": false,
      "properties": {
        "cpu_model": { "type": ["string", "null"] },
        "arch": { "type": "string", "description": "x86_64 / aarch64" },
        "build_path": { "type": ["string", "null"], "description": "AVX2 / AVX512 / NEON / reference. Confirming the actual liboqs code path is a documented manual step." },
        "cpu_flags": { "type": "array", "items": { "type": "string" }, "description": "Detected SIMD flags as a proxy for build_path" },
        "cpu_hz_nominal": { "type": ["number", "null"], "description": "Approximate; turbo/scaling/steal make absolute cycle conversion unreliable" },
        "steal_time_pct": { "type": ["number", "null"], "description": "CPU steal during the run. The thing that forces the c7i.large decision." }
      }
    },
    "audit": {
      "type": "object",
      "required": ["git_commit", "timestamp_utc"],
      "additionalProperties": false,
      "properties": {
        "git_commit": { "type": ["string", "null"] },
        "timestamp_utc": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "timing_stats": {
      "type": "object",
      "description": "Microseconds. Same shape as benchmark.py compute_stats so protocol results slot into the existing pipeline.",
      "required": ["mean_us", "median_us", "p95_us", "p99_us", "stdev_us", "min_us", "max_us", "ops_per_sec", "n_iterations"],
      "additionalProperties": false,
      "properties": {
        "mean_us": { "type": "number", "minimum": 0 },
        "median_us": { "type": "number", "minimum": 0 },
        "p95_us": { "type": "number", "minimum": 0 },
        "p99_us": { "type": "number", "minimum": 0 },
        "stdev_us": { "type": "number", "minimum": 0 },
        "min_us": { "type": "number", "minimum": 0 },
        "max_us": { "type": "number", "minimum": 0 },
        "ops_per_sec": { "type": "number", "minimum": 0 },
        "n_iterations": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
